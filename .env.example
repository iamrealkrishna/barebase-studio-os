# Postgres connection string.
# On Vercel, adding a Neon / Vercel Postgres integration sets this for you.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Secret used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Absolute base URL of the deployment. Used to build client share links.
# Optional on Vercel — falls back to VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
APP_URL="http://localhost:3000"

# Windows on ARM only. Prisma ships no ARM64 Windows engine, so an ARM64-native
# Node can't load the x64 one ("not a valid Win32 application"). These run it as
# a separate emulated process instead. Local machines only — leave them unset on
# Vercel so production keeps the faster in-process library engine.
# PRISMA_CLIENT_ENGINE_TYPE=binary
# PRISMA_CLI_QUERY_ENGINE_TYPE=binary

# Seed-only. Credentials for the first admin created by `npm run db:seed`.
SEED_ADMIN_EMAIL="krishna@barebase.in"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Krishna"
SEED_ORG_NAME="Barebase"
