# Copy to .env for local development. Never commit real values.

# Postgres on Neon. Local dev and tests use a local database or the Neon "staging" branch, never production.
DATABASE_URL="postgresql://user:password@localhost:5432/barebase_studio"

# Hostname of the production database (no credentials). Set in every Vercel environment.
# The build refuses to migrate when a Preview deployment points at this host.
PRODUCTION_DATABASE_HOST=""

# Long random string for signing session cookies (openssl rand -base64 48).
AUTH_SECRET=""

# Resend, sending from studio@barebase.in (Phase 0).
RESEND_API_KEY=""

# Vercel Blob read/write token (Phase 0).
BLOB_READ_WRITE_TOKEN=""

# Public URL of this deployment, used in emailed links.
APP_URL="http://localhost:3000"

# Playwright: where the app under test runs. Anything other than localhost also needs E2E_TARGET=staging.
# E2E_BASE_URL="https://staging-url.vercel.app"
# E2E_TARGET="staging"
