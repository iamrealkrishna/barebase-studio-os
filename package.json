{
  "name": "barebase-studio-os",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/migrate-on-deploy.mjs && next build",
    "build:local": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . && node scripts/check-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && tsx tests/unit-rate-card-identity.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:cleanup": "tsx tests/cleanup.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "jose": "6.2.4",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "0.555.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.2.12",
    "prisma": "6.19.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.0.15"
  },
  "engines": {
    "node": ">=22"
  }
}
